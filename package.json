{
  "name": "clinic-apis",
  "private": true,
  "type": "module",
  "workspaces": ["frontend"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "go run ./backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "go build -o dist/clinic-api ./backend",
    "start": "./dist/clinic-api",
    "lint": "npm run lint --workspace frontend",
    "test": "node --env-file-if-exists=.env.local --run test:go",
    "test:go": "go test -race ./backend/...",
    "db:generate": "sqlc generate",
    "test:smoke": "node scripts/smoke.mjs",
    "neon:deploy": "neon deploy"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
