# Neon writes real connection strings to .env.local. Never commit that file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Go listens on this port. Render supplies PORT automatically.
PORT=8080
FRONTEND_DIST=frontend/dist

# Tests use a separate database, never the deployed app's database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_test?sslmode=disable
